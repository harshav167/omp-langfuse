{
  "name": "@langfuse/pi-observability-plugin",
  "version": "0.2.0",
  "description": "Langfuse observability plugin for oh-my-pi (omp) — traces prompts, agent and subagent turns, model generations, tool calls, retries and compaction to Langfuse.",
  "license": "MIT",
  "author": "Langfuse",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langfuse/pi-observability-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/langfuse/pi-observability-plugin/issues"
  },
  "homepage": "https://github.com/langfuse/pi-observability-plugin#readme",
  "keywords": [
    "omp-plugin",
    "omp-extension",
    "omp",
    "oh-my-pi",
    "langfuse",
    "observability",
    "tracing",
    "opentelemetry"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000 test/*.test.ts",
    "test:unit": "bun test test/unit.test.ts test/config.test.ts",
    "backfill": "bun src/backfill.ts"
  },
  "dependencies": {
    "@langfuse/otel": "^5.13.0",
    "@langfuse/tracing": "^5.13.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.6.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.6.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "workspaces": ["."]
}
